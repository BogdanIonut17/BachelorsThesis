{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "RootPath": null
  },
  "Ffmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "FrameSampleIntervalSeconds": 2.0,
    "MaxExtractedFrames": 120,
    "SilenceNoiseDb": -35,
    "MinSilenceDurationSeconds": 1.5,
    "ProcessTimeoutSeconds": 900
  }
}
